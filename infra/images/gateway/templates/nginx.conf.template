# DisputeDesk gateway: the single entry point of the platform.
#   app origin       the SPA; /api/, /scalar/ and /openapi/v1.json -> api; /otlp/v1/* -> the OTLP/HTTP receiver
#   identity origin  Zitadel API, console and the hosted login (/ui/login)
#
# A template: at start, the image's entrypoint renders /etc/nginx/templates/*.template with envsubst into /etc/nginx,
# filling in the GATEWAY_* variables that docker-compose.yml sets. A variable left unset stays as ${NAME}. Where nginx
# reads that as a variable (proxy_set_header, proxy_pass, add_header), it rejects it as unknown and the gateway refuses
# to start; server_name takes no variables, so there it would stay a literal name that no request matches.
#
# This is the edge: upstreams get a fixed Host for their origin (never the client's raw Host, which only has to match
# server_name, port aside) and X-Forwarded-For is the peer address, not a client-supplied chain. A client's RFC 7239
# Forwarded header is dropped (an empty proxy_set_header value is not passed), because Zitadel resolves its instance
# from it; each proxied location says so itself, since a location that sets any proxy_set_header inherits none. This
# is the local edge; trusting CloudFront's client address and scheme in AWS is story 7.4.
worker_processes 1;
pid /tmp/nginx.pid;

events { worker_connections 1024; }

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;
  sendfile      on;
  server_tokens off;

  # Every origin's one log format: the combined format with the path ($uri) in place of the request line, and no
  # Referer. A query can carry the sign-in callback's code or the end-session id_token_hint, and a Referer can carry a
  # URL with its query, so neither is logged (NFR-SEC-5, AD-20, ASVS 5.0 V14.2.1; nginx ngx_http_log_module). Defined
  # before its first use, and named on every log line: a line without a name logs the combined format.
  log_format    path_only '$remote_addr - $remote_user [$time_local] "$request_method $uri $server_protocol" '
                          '$status $body_bytes_sent "$http_user_agent"';
  access_log    /var/log/nginx/access.log path_only;

  # The image runs as a non-root user, which can write only under /tmp (the image's own defaults).
  client_body_temp_path /tmp/client_temp;
  proxy_temp_path       /tmp/proxy_temp;
  fastcgi_temp_path     /tmp/fastcgi_temp;
  uwsgi_temp_path       /tmp/uwsgi_temp;
  scgi_temp_path        /tmp/scgi_temp;

  # The api is looked up at run time (resolve), through Docker's embedded DNS, not at start, so the gateway starts
  # before the api: the api waits for this gateway, whose auth.localhost alias its issuer lookups need
  # (docker-compose.yml). Until the api starts, nginx logs that it could not be resolved.
  resolver 127.0.0.11 valid=10s;
  upstream api           { zone api 64k; server api:8080 resolve; keepalive 16; }
  upstream zitadel_api   { server zitadel:8080;       keepalive 16; }

  # The coarse per-client limit on /api/, /otlp/ and the Scalar locations (AD-23): 10 requests per second, with bursts of up to 20 served
  # at once (nodelay) instead of queued. A rejected request gets 429 (RFC 6585).
  limit_req_zone $binary_remote_addr zone=coarse:10m rate=10r/s;
  limit_req_status 429;

  # The identity origin's Referrer-Policy (identity-headers.conf): the gateway's value where the upstream sent none,
  # empty (no header) where it sent its own (nginx ngx_http_map_module). On a response nginx makes itself there is no
  # upstream, so the variable is empty too.
  map $upstream_http_referrer_policy $identity_referrer_policy {
    default "";
    ""      "strict-origin-when-cross-origin";
  }

  # ---------------------------------------------------------------------------------------------
  # App origin: every host that is not the identity origin.
  # ---------------------------------------------------------------------------------------------
  server {
    listen 8080 default_server;

    include /etc/nginx/security-headers.conf;

    # The gateway's own 429 as RFC 9457 problem details. No traceId: nginx has no trace context (AD-3).
    # Retry-After in seconds (RFC 9110 10.2.3), matching the 10r/s limit. This block adds a header, so it repeats the
    # rest. The empty types block stops nginx picking a Content-Type from the request's extension (a limited .json).
    # no-store, because the Api never sees this response and so cannot add its own (RFC 9111 5.2.2.5; AD-23).
    error_page 429 @rate_limited;
    location @rate_limited {
      include /etc/nginx/security-headers.conf;
      add_header Retry-After "1" always;
      add_header Cache-Control "no-store" always;
      types { }
      default_type application/problem+json;
      return 429 '{"type":"https://github.com/njabulozmnisi/disputedesk/blob/main/docs/problems/rate-limited.md","title":"Too many requests","status":429}';
    }

    # The gateway's own 413, 500, 502 and 504 on /api (AD-23 as amended 2026-10-31): no-store and the security headers,
    # since the Api never sees these responses. error_page without "=" keeps the original status (nginx, error_page),
    # so the client gets that status with this fixed text; the 200 below is never sent. The /api locations send here.
    location @gateway_error {
      include /etc/nginx/security-headers.conf;
      add_header Cache-Control "no-store" always;
      types { }
      default_type text/plain;
      return 200 "The gateway could not complete the request.\n";
    }

    # The SPA: client-side routes fall back to index.html, but a missing build file is a plain 404. index.html is
    # revalidated on every load, so a release reaches the browser at once; the hashed build files never change, so they
    # are cached for a year (RFC 9111 5.2.2.4, RFC 8246). Without "always", a 404 is never cached. Each location adds a
    # header, so it repeats the rest. Both name the charset of their text files (.html, .css, .js) in Content-Type
    # (ASVS 5.0 V4.1.1; nginx ngx_http_charset_module): here only, so no proxied response is relabelled.
    root /usr/share/nginx/html;
    location / {
      include /etc/nginx/security-headers.conf;
      add_header Cache-Control "no-cache";
      charset utf-8;
      charset_types text/html text/css application/javascript;
      try_files $uri /index.html;
    }
    location /assets/ {
      include /etc/nginx/security-headers.conf;
      add_header Cache-Control "public, max-age=31536000, immutable";
      charset utf-8;
      charset_types text/html text/css application/javascript;
      try_files $uri =404;
    }

    # The api keeps its health endpoints at the root (/health/*); expose them under /api/health/*. Each /api location
    # sends the gateway's own errors to @gateway_error and repeats the 429 line, because a location that sets error_page
    # inherits none from its server. The Api's own responses pass through untouched (proxy_intercept_errors is off).
    location /api/health/ {
      limit_req zone=coarse burst=20 nodelay;
      error_page 429 @rate_limited;
      error_page 413 500 502 504 @gateway_error;
      proxy_pass http://api/health/;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host ${GATEWAY_APP_HOST};
      proxy_set_header X-Forwarded-Host ${GATEWAY_APP_HOST};
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header Forwarded "";
    }

    # Everything else under /api/ keeps its path: the api serves /api/v1/... itself.
    location /api/ {
      limit_req zone=coarse burst=20 nodelay;
      error_page 429 @rate_limited;
      error_page 413 500 502 504 @gateway_error;
      proxy_pass http://api;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host ${GATEWAY_APP_HOST};
      proxy_set_header X-Forwarded-Host ${GATEWAY_APP_HOST};
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header Forwarded "";
    }

    # Scalar and the runtime OpenAPI document, served by the api when Scalar:Enabled is true and its 401 otherwise
    # (AD-26). The path stays unchanged, because the page's inline script embeds it and its CSP hash holds for exactly
    # /scalar/. These locations send the Scalar CSP (scalar-headers.conf); a 429 is still @rate_limited's.
    # /scalar gets the api's 302 to scalar/. Only v1.json reaches the api; any other /openapi/ path is the SPA's.
    location = /scalar {
      include /etc/nginx/scalar-headers.conf;
      limit_req zone=coarse burst=20 nodelay;
      proxy_pass http://api;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host ${GATEWAY_APP_HOST};
      proxy_set_header X-Forwarded-Host ${GATEWAY_APP_HOST};
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header Forwarded "";
    }

    location /scalar/ {
      include /etc/nginx/scalar-headers.conf;
      limit_req zone=coarse burst=20 nodelay;
      proxy_pass http://api;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host ${GATEWAY_APP_HOST};
      proxy_set_header X-Forwarded-Host ${GATEWAY_APP_HOST};
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header Forwarded "";
    }

    location = /openapi/v1.json {
      include /etc/nginx/scalar-headers.conf;
      limit_req zone=coarse burst=20 nodelay;
      proxy_pass http://api;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host ${GATEWAY_APP_HOST};
      proxy_set_header X-Forwarded-Host ${GATEWAY_APP_HOST};
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header Forwarded "";
    }

    # The SPA's telemetry, same origin so the CSP keeps connect-src 'self' (AD-29). OTLP/HTTP exporters only POST
    # to the three signal paths, so anything else is refused. /otlp/v1/traces goes to <endpoint>/v1/traces.
    location ~ ^/otlp/v1/(traces|metrics|logs)$ {
      if ($request_method != POST) {
        # A 405 must list the allowed methods (RFC 9110 15.5.6). This block adds a header, so it repeats the rest.
        include /etc/nginx/security-headers.conf;
        add_header Allow "POST" always;
        return 405;
      }
      limit_req zone=coarse burst=20 nodelay;
      client_max_body_size 1m;
      rewrite ^/otlp(/.*)$ $1 break;
      proxy_pass ${GATEWAY_OTLP_ENDPOINT};
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      # The receiver needs no credentials, so the session and antiforgery cookies and any Authorization stay at the
      # edge (an empty value is not passed upstream).
      proxy_set_header Cookie "";
      proxy_set_header Authorization "";
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header Forwarded "";
    }
  }

  # ---------------------------------------------------------------------------------------------
  # Identity origin: Zitadel API and the hosted login on one host (a separate login origin fights the
  # login's own CSP, see the Zitadel lab notes). Zitadel resolves its instance from the Host,
  # which must be exactly ExternalDomain:ExternalPort. No app CSP here: the login sets its own.
  # ---------------------------------------------------------------------------------------------
  server {
    listen 8080;
    server_name ${GATEWAY_AUTH_SERVER_NAME};

    # The identity baseline on every response (identity-headers.conf), each header once, the upstreams' own copies
    # hidden. Referrer-Policy once: Zitadel's own same-origin on its console and v1 login, the gateway's
    # strict-origin-when-cross-origin wherever the upstream sends none (the 302 below, discovery).
    include /etc/nginx/identity-headers.conf;


    location = / { return 302 /ui/login/; }

    # OIDC, REST, Connect (HTTP/1.1), console and assets.
    location / {
      proxy_pass http://zitadel_api;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host ${GATEWAY_AUTH_HOST};
      proxy_set_header X-Forwarded-Host ${GATEWAY_AUTH_HOST};
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-For $remote_addr;
      proxy_set_header Forwarded "";
      proxy_buffering off;
    }
  }
}
