# The Scalar locations' browser security headers (AD-26, story 5.5), each set exactly once per response: nginx inherits
# add_header only into a level that sets none, so this file repeats every header of security-headers.conf with the same
# value, and only the CSP differs (OWASP HTTP Headers Cheat Sheet; nginx ngx_http_headers_module).
# script-src allows the page's one inline script by its hash (CSP Level 3 hash-source), never 'unsafe-inline'. The hash
# holds for the page at exactly /scalar/ with the options in ApiReferenceEndpoints.cs; ApiReferenceTests hashes the
# served script against this line, so a Scalar upgrade or option change fails CI until it is updated.
# style-src has 'unsafe-inline' because Scalar adds its stylesheet at runtime, and never a hash, which would make
# browsers ignore 'unsafe-inline'. connect-src stays 'self': Scalar fetches no token itself.
add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-b0mHo+33wFKw5oMaKqYunih9sds9KPWLo3LwHpOimEk='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
add_header Strict-Transport-Security "${GATEWAY_HSTS}" always;
