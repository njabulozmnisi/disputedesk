{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployParameters",
      "Effect": "Allow",
      "Action": "ssm:GetParametersByPath",
      "Resource": [
        "${ssm_parameter_arn}${ssm_path}",
        "${ssm_parameter_arn}${ssm_path}/*"
      ]
    },
    {
      "Sid": "DataProtectionKeyRing",
      "Effect": "Allow",
      "Action": ["ssm:GetParametersByPath", "ssm:PutParameter"],
      "Resource": [
        "${ssm_parameter_arn}${dataprotection_ssm_path}",
        "${ssm_parameter_arn}${dataprotection_ssm_path}/*"
      ]
    },
    {
      "Sid": "DecryptThroughSsm",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "${kms_key_arn}",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.${aws_region}.amazonaws.com" } }
    },
    {
      "Sid": "EncryptKeyRing",
      "Effect": "Allow",
      "Action": "kms:Encrypt",
      "Resource": "${kms_key_arn}",
      "Condition": { "StringLike": { "kms:EncryptionContext:PARAMETER_ARN": "${ssm_parameter_arn}${dataprotection_ssm_path}/*" } }
    },
    {
      "Sid": "XRayOtlpSpans",
      "Effect": "Allow",
      "Action": ["xray:PutSpans", "xray:PutSpansForIndexing"],
      "Resource": "*"
    }
  ]
}
