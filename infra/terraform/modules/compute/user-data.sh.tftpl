#!/bin/bash
# First boot of the Compose host (AD-28). cloud-init runs user data once, as root (Amazon EC2, "Run commands when you
# launch an instance"). Rendered by Terraform; the deploy document runs infra/deploy/aws/deploy.sh from the clone.
set -euo pipefail

# Docker, git and jq from the AL2023 repositories; iptables-services restores the deploy script's DOCKER-USER rule at
# boot, before Docker starts the containers (Amazon ECS Developer Guide, blocking container access to instance metadata).
dnf install -y docker git jq iptables-services
systemctl enable --now docker

# The Docker Compose plugin, which AL2023 does not package, pinned by version and SHA-256 (Docker, "Install the plugin
# manually").
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL --max-time 300 -o /tmp/docker-compose \
  "https://github.com/docker/compose/releases/download/v${compose_version}/docker-compose-linux-x86_64"
echo "${compose_sha256}  /tmp/docker-compose" | sha256sum --check --strict
install -m 0755 /tmp/docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
rm /tmp/docker-compose

# AD-28's 2 GiB swap file.
dd if=/dev/zero of=/swapfile bs=1M count=2048
chmod 600 /swapfile
mkswap /swapfile
swapon /swapfile
echo '/swapfile swap swap defaults 0 0' >> /etc/fstab

git clone --quiet "https://github.com/${github_repository}.git" "${clone_directory}"
