{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "SessionCookie": { "Name": "__Host-disputedesk-session" },
    "AntiforgeryCookie": { "Name": "__Host-disputedesk-antiforgery" },
    "CorrelationCookie": { "Name": "__Host-disputedesk-correlation." },
    "NonceCookie": { "Name": "__Host-disputedesk-nonce." },
    "Cookie": { "SecurePolicy": "Always" }
  },
  "Scalar": { "Enabled": false },
  "Linking": {
    "RateLimits": { "PermitsPerLogin": 5, "PermitsPerIp": 20, "Window": "00:15:00", "SegmentsPerWindow": 15 }
  }
}
